    {
      "name": "sharepoint_workday_export_reader",
      "description": "Read new-hire rows from a Workday Excel export in a designated SharePoint folder. Read-only.",
      "annotations": {
        "readOnlyHint": true,
        "requireConfirmation": false
      },
      "inputSchema": {
        "type": "object",
        "required": [
          "folder_path"
        ],
        "properties": {
          "folder_path": {
            "type": "string"
          },
          "file_name": {
            "type": "string"
          },
          "job_profiles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "as_of_date": {
            "type": "string",
            "format": "date"
          }
        }
      }
    },
