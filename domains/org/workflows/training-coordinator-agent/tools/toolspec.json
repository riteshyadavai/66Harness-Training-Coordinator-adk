    {
      "name": "compute_eligibility",
      "description": "Deterministically calculate tenure and return eligible, ineligible, or hold_next_cycle.",
      "annotations": {
        "readOnlyHint": true,
        "requireConfirmation": false
      },
      "inputSchema": {
        "type": "object",
        "required": [
          "employee_id",
          "job_profile",
          "start_date",
          "as_of_date",
          "program"
        ],
        "properties": {
